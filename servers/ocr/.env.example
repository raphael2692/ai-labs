# Copy to .env and adjust for this machine.
OCR_HOST=0.0.0.0
OCR_PORT=9100
OCR_MODEL=baidu/Unlimited-OCR
OCR_DEVICE=cuda
OCR_DTYPE=bfloat16

# Per-page inference sizes, shared by both image_modes (see README): "gundam" crops
# tiles at OCR_IMAGE_SIZE plus a global view at OCR_BASE_SIZE; "base" runs one
# uncropped pass at OCR_BASE_SIZE. The caller picks image_mode per request.
OCR_BASE_SIZE=1024
OCR_IMAGE_SIZE=640
OCR_MAX_LENGTH=32768

# DPI used to rasterize PDF pages to images before OCR.
OCR_PDF_DPI=300
