# Copy to .env and adjust for this machine.
OCR_HOST=0.0.0.0
OCR_PORT=9100
OCR_MODEL=baidu/Unlimited-OCR
OCR_DEVICE=cuda
OCR_DTYPE=bfloat16

# Single-image / single-page inference config ("gundam" preset from the model card).
OCR_BASE_SIZE=1024
OCR_IMAGE_SIZE=640
OCR_CROP_MODE=true
OCR_MAX_LENGTH=32768

# DPI used to rasterize PDF pages to images before OCR.
OCR_PDF_DPI=300
