# Copy to .env and adjust for this machine.
UNSLOTH_HOST=0.0.0.0
UNSLOTH_PORT=8888

# Required. GGUF repo, optionally with a ":QUANT" suffix.
# TODO: set to your favorite model once decided.
# (passed as `unsloth run --model $UNSLOTH_MODEL`)
# e.g. UNSLOTH_MODEL=unsloth/gemma-4-26B-A4B-it-GGUF:UD-Q4_K_XL
UNSLOTH_MODEL=

# Printed to the console on first `unsloth run` (or created via Settings -> API
# in the Studio UI). Copy it here, then copy this same value into the repo-root
# .env so client apps can authenticate.
UNSLOTH_STUDIO_AUTH_TOKEN=
