# Copy to .env and adjust for this machine.
UNSLOTH_HOST=0.0.0.0
UNSLOTH_PORT=8888

# TODO: set to your favorite model id/path once decided
# (passed as `unsloth studio --model $UNSLOTH_MODEL` when set)
UNSLOTH_MODEL=

# Generated manually the first time the server starts (see README) and then
# copied here so client apps' .env can reference the same value.
UNSLOTH_STUDIO_AUTH_TOKEN=
