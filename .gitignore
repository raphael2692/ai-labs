# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets/config - copied from each .env.example
.env
servers/*/.env
apps/*/.env

# Streamlit
.streamlit/secrets.toml

# Pipeline app - user-local saved prompts
apps/pipeline/prompts.json

# Unsloth runtime cache
servers/unsloth/unsloth_compiled_cache/

# uv lockfile - not tracked, machine-specific
uv.lock
