# Copy to .env. Read by apps/common's Settings for every Streamlit app.
# These point at wherever your Whisper / Unsloth servers actually run —
# they don't have to be this machine. See servers/whisper and servers/unsloth.

WHISPER_API_URL=http://localhost:9000/v1/audio/transcriptions
UNSLOTH_API_BASE=http://localhost:8888/v1
UNSLOTH_STUDIO_AUTH_TOKEN=

# Model id to send in chat completion requests. This is NOT the GGUF repo string
# used to launch the server (servers/unsloth's UNSLOTH_MODEL) - fetch the loaded
# model's actual id via: curl $UNSLOTH_API_BASE/models -H "Authorization: Bearer $UNSLOTH_STUDIO_AUTH_TOKEN"
UNSLOTH_MODEL=default

